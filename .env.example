# =============================================================================
# ROOT ENVIRONMENT (dibaca docker-compose.yml) — untuk lokal / server sederhana
#   cp .env.example .env
# Untuk produksi dengan HTTPS pakai .env.production.example.
# =============================================================================

# --- Identitas stack ---------------------------------------------------------
# Nama unik per situs (huruf kecil, tanpa spasi). Menjadi prefix nama container,
# volume & network -> beberapa situs bayi bisa jalan di satu server.
APP_NAME=firli

# --- General -----------------------------------------------------------------
NODE_ENV=production

# --- Nginx (pintu masuk publik) ------------------------------------------------
NGINX_PORT=80          # ganti mis. 8085 bila port 80 sudah terpakai situs lain

# --- Backend -----------------------------------------------------------------
BACKEND_PORT=3000
# Asal (origin) yang diizinkan CORS. Di produksi isi URL publik, mis. https://firli.cels.site
CORS_ORIGIN=*
IP_HASH_SALT=change_me_random_salt
# true = ucapan langsung tampil | false = perlu disetujui dulu via phpMyAdmin
WISH_AUTO_APPROVE=true
# Opsional: frontend sudah mengirim slug dari site.config.js
DEFAULT_BABY_SLUG=

# --- Frontend (build-time) -----------------------------------------------------
VITE_API_BASE_URL=/api

# --- Database (MariaDB) --------------------------------------------------------
DB_NAME=baby_db
DB_USER=baby_user
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_strong_root_password

# --- phpMyAdmin ------------------------------------------------------------------
# Tiap situs di server yang sama butuh port berbeda (8080, 8081, ...)
PMA_PORT=8080
