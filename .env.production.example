# =============================================================================
# PRODUCTION ENVIRONMENT  ->  salin ke ".env" di server lalu edit.
#   cp .env.production.example .env && chmod 600 .env
# Buat secret kuat, mis.:  openssl rand -base64 24
# =============================================================================

# --- Identitas stack ---------------------------------------------------------
# Nama unik per situs -> prefix container/volume/network (lihat docs/DEPLOYMENT.md
# bagian "Beberapa situs di satu server").
APP_NAME=aruna

# --- Domain & TLS ----------------------------------------------------------
DOMAIN=aruna.example.com
CERTBOT_EMAIL=you@example.com
# Pakai staging Let's Encrypt (1) saat uji coba agar tidak kena rate limit, lalu 0.
CERTBOT_STAGING=0

# --- Ports (nginx) -----------------------------------------------------------
# Ganti bila 80/443 sudah dipakai layanan lain di host (mis. NGINX_PORT=8085).
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# --- App -------------------------------------------------------------------
NODE_ENV=production
VITE_API_BASE_URL=/api
# Kunci CORS ke origin asli di produksi
CORS_ORIGIN=https://aruna.example.com
IP_HASH_SALT=change_me_long_random_value
# true = ucapan langsung tampil | false = perlu disetujui dulu via phpMyAdmin
WISH_AUTO_APPROVE=true
DEFAULT_BABY_SLUG=

# --- Database (TIDAK dibuka ke publik) ---------------------------------------
DB_NAME=baby_db
DB_USER=baby_user
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_strong_root_password

# --- phpMyAdmin (hanya 127.0.0.1; akses via SSH tunnel) ------------------------
PMA_PORT=8080
PMA_ABSOLUTE_URI=http://localhost:8080/
